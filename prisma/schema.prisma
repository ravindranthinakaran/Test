generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

model Route {
  id          String   @id @default(cuid())
  origin      String
  destination String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  buses       Bus[]

  @@index([origin, destination])
}

model Bus {
  id        String   @id @default(cuid())
  name      String
  busNumber String   @unique
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)
  seats     Seat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeId])
}

model Seat {
  id        String    @id @default(cuid())
  seatNumber String
  isBooked   Boolean   @default(false)
  busId     String
  bus       Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([busId, seatNumber])
  @@index([busId])
}

model Booking {
  id          String         @id @default(cuid())
  bookingDate DateTime
  status      BookingStatus  @default(pending)
  userId      String
  seatId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat        Seat           @relation(fields: [seatId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([seatId])
  @@index([status])
}
